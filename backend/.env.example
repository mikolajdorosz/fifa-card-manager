# Skopiuj ten plik jako .env i uzupełnij wartości

# Serwer
PORT=3001
NODE_ENV=development

# JWT — wygeneruj losowy ciąg znaków (np. openssl rand -base64 64)
JWT_SECRET=zmien_ten_sekret_na_losowy_ciag_znakow_min_32_chars

# TheSportsDB API — klucz darmowy to "3"
SPORTSDB_API_KEY=3
SPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json/3

# Baza danych SQLite — ścieżka do pliku
DB_PATH=./database.sqlite

# Upload zdjęć — limit rozmiaru pliku
MAX_FILE_SIZE_MB=5
